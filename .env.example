# ==============================================================================
# TribalScholar AI — Environment Variables Template (.env.example)
# Problem Statement 26239: AI-Enabled Scholarship & Fellowship Management
# ==============================================================================

# Database Connection (Docker Compose PostgreSQL 15 on port 5433 to avoid host collision)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5433/tribalscholar_db?schema=public"

# Authentication & Session (NextAuth.js)
NEXTAUTH_SECRET="insecure-dev-secret-replace-in-production-only-for-local-demo-min32chars"
NEXTAUTH_URL="http://localhost:3000"

# Application Mode
NODE_ENV="development"

# Storage Configuration
# Options: 'local' (prototype) | 's3' | 'gcs'
STORAGE_DRIVER="local"
STORAGE_LOCAL_ROOT="./uploads/documents"

# Port configuration for Docker Postgres
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=tribalscholar_db

# AI / OCR Service Configuration (Optional external LLM fallback)
# Leave empty to use local fallback OCR pipeline (Tesseract.js + pdf-parse)
GEMINI_API_KEY=""
OCR_ENGINE="local"
