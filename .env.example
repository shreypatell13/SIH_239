# ==============================================================================
# TribalScholar AI — Environment Variables Template (.env.example)
# Problem Statement 26239: AI-Enabled Scholarship & Fellowship Management
# ==============================================================================

# Database Connection (Docker Compose PostgreSQL on port 5433 to avoid host collision)
DATABASE_URL="postgresql://postgres:postgrespassword@localhost:5433/tribalscholar_db?schema=public"

# Authentication & Session (NextAuth.js)
# WARNING: Replace with a cryptographically secure 32+ character random string in production
NEXTAUTH_SECRET="insecure-dev-secret-replace-in-production-only-for-local-demo-min32chars"
NEXTAUTH_URL="http://localhost:3000"

# Application Mode
NODE_ENV="development"

# Storage Configuration
# Options: 'local' (prototype) | 's3' | 'gcs'
STORAGE_DRIVER="local"
STORAGE_LOCAL_ROOT="./uploads/documents"

# External Government Integration Adapters
# Options: 'mock' (default synthetic adapter) | 'live' (production adapter when verified)
INTEGRATION_MODE="mock"
DIGILOCKER_API_BASE_URL=""
DIGILOCKER_CLIENT_ID=""
DIGILOCKER_CLIENT_SECRET=""
PFMS_API_BASE_URL=""
PFMS_AGENCY_CODE=""
PFMS_API_KEY=""
NSP_API_BASE_URL=""
NSP_API_KEY=""
MOTA_GATEWAY_URL=""

# Port configuration for Docker Postgres
POSTGRES_PORT=5433
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=tribalscholar_db

# AI / OCR Service Configuration (Optional external LLM fallback)
# Leave empty to use local fallback OCR pipeline (Tesseract.js + pdf-parse)
GEMINI_API_KEY=""
OCR_ENGINE="local"

# Demo / Prototype Presentation Settings
# Configurable delay in milliseconds for document intelligence processing reveal (default: 35000 ms = 35s)
DEMO_OCR_DELAY_MS=35000
